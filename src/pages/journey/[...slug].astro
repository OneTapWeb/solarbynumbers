---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journey');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
// neighbours in date order, for previous / next links
const all = (await getCollection('journey')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const at = all.findIndex((p) => p.id === post.id);
const prev = at > 0 ? all[at - 1] : null;
const next = at < all.length - 1 ? all[at + 1] : null;
const { Content } = await render(post);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString().slice(0, 10),
  url: new URL(`/journey/${post.id}/`, Astro.site).href,
  isPartOf: { '@type': 'Blog', name: 'Solar by Numbers journey', url: new URL('/journey/', Astro.site).href },
  author: { '@type': 'Person', name: 'Solar by Numbers' },
};
---

<Base title={post.data.title} description={post.data.summary} ogType="article" jsonLd={jsonLd}>
  <article class="post">
    <h1>{post.data.title}</h1>
    <p class="muted mono" style="margin-top:0.6rem"><time datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDate(post.data.date)}</time></p>
    <div style="margin-top:1.4rem">
      <Content />
    </div>
    <hr />
    <nav class="post-nav" aria-label="More diary entries">
      {prev && <a href={`/journey/${prev.id}/`} rel="prev"><small>Earlier</small>{prev.data.title}</a>}
      {next && <a class="next" href={`/journey/${next.id}/`} rel="next"><small>Later</small>{next.data.title}</a>}
    </nav>
    <p class="muted" style="margin-top:1.6rem">
      <a href="/journey/">All diary entries</a> ·
      <a href="/stats/">Latest numbers</a>
    </p>
  </article>
</Base>
