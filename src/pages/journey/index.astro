---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('journey')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase();

// Commissioning is the day the scoreboard starts, so it gets the filled dot.
const COMMISSIONED = '2026-06-04';
---

<Base title="The journey" description="Install diary for a UK solar, battery and Predbat project, from quote to commissioning to live automation, with the lessons learned along the way.">
  <div class="page-head">
    <h1>Install diary</h1>
    <p class="lede">
      From the first quote to the system running on its own, in the order it happened,
      including the things that went wrong.
    </p>
  </div>

  <div class="timeline">
    {posts.map((p) => (
      <article class={`entry${p.data.date.toISOString().slice(0, 10) === COMMISSIONED ? ' mark' : ''}`}>
        <span class="when">{fmtDate(p.data.date)}</span>
        <h2><a href={`/journey/${p.id}/`}>{p.data.title}</a></h2>
        <p>{p.data.summary}</p>
      </article>
    ))}
    <article class="entry">
      <span class="when">Still to come</span>
      <h2>The heat pump</h2>
      <p>Due December 2026, after which the house won't burn any gas. We've done the <a href="/heat-pump/">sizing
      and the sums</a>, but the radiators haven't been changed yet.</p>
    </article>
  </div>
</Base>
