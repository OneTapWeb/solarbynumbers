---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import appsYaml from '../../public/configs/apps.yaml?raw';
import bridgeYaml from '../../public/configs/predbat_sigenergy_bridge.yaml?raw';
import helpersYaml from '../../public/configs/helpers.yaml?raw';
import enableJq from '../../public/configs/enable_entities.jq?raw';
import energyPrefs from '../../public/configs/energy_prefs.json?raw';

const files = [
  {
    name: 'apps.yaml', lang: 'yaml', code: appsYaml, dl: '/configs/apps.yaml', tag: 'Predbat',
    desc: 'Predbat entity map for Sigenergy',
    blurb: 'The full Predbat configuration for a Sigenergy EC-series hybrid (inverter_type: SIG) on Intelligent Octopus Go plus flat 12p export, with Solcast forecasting and Saving Session support. The regex entity matchers should mean it works on most single-inverter Sigenergy installs without changes. The rate limits are read from sensors rather than hard-coded, which saved us some work when our inverter turned out to be a different model from the one we ordered.',
  },
  {
    name: 'predbat_sigenergy_bridge.yaml', lang: 'yaml', code: bridgeYaml, dl: '/configs/predbat_sigenergy_bridge.yaml', tag: 'Bridge',
    desc: 'Maps Predbat\'s requested mode onto the Sigenergy EMS',
    blurb: 'The three automations that bridge Predbat to the Sigenergy EMS. Predbat sets input_select.predbat_requested_mode; the first automation maps each mode (Demand / Charging / Discharging / both Freezes) onto sigen_plant_remote_ems_control_mode and the charge and discharge cut-off registers. The other two clamp Predbat\'s requested W rates onto the inverter\'s kW limit registers.',
  },
  {
    name: 'helpers.yaml', lang: 'yaml', code: helpersYaml, dl: '/configs/helpers.yaml', tag: 'Helpers',
    desc: 'The input_select and input_number entities the bridge depends on',
    blurb: 'Append to configuration.yaml, or to your packages directory.',
  },
  {
    name: 'enable_entities.jq', lang: 'text', code: enableJq, dl: '/configs/enable_entities.jq', tag: 'Fix',
    desc: 'Switches on the hidden Sigenergy control entities',
    blurb: 'The Sigenergy integration ships several control entities switched off by default, including the remote EMS mode select that the whole bridge hangs on. This jq filter turns them on in the entity registry. Run it against core.entity_registry with HA stopped, or enable them by hand in the UI.',
  },
  {
    name: 'energy_prefs.json', lang: 'json', code: energyPrefs, dl: '/configs/energy_prefs.json', tag: 'Dashboard',
    desc: 'Energy dashboard sources',
    blurb: 'Grid import and export and battery from the Sigenergy cumulative meters, live import pricing from the Octopus integration, solar forecast from Solcast. Replace the MPAN, serial and Solcast config-entry placeholders with your own.',
  },
];
---

<Base title="The configs" description="The exact sanitized Predbat apps.yaml, Sigenergy bridge automations, helpers and energy dashboard config running a UK Sigenergy, Intelligent Octopus Go and Outgoing Octopus install.">
  <div class="page-head">
    <h1>The configs</h1>
    <p class="lede">
      Getting Predbat and Sigenergy working together took a lot of trial and error. These are the
      actual files running our system, free to copy. The only changes are that credentials and
      meter identifiers have been replaced with placeholders.
    </p>
  </div>

  <div class="note">
    <p><strong>Before you copy:</strong> entity IDs assume the HACS Sigenergy ESS integration's
    default naming (<code>sigen_plant_*</code>) and a single plant. Check yours in Developer Tools
    → States. None of these files contain secrets. API keys are kept in <code>secrets.yaml</code>, which
    isn't published.</p>
  </div>

  {files.map((f) => (
    <section style="margin-top:2rem">
      <div class="codefile">
        <div class="head">
          <div>
            <span class="name">{f.name}</span>
            <span class="desc">{f.desc}</span>
          </div>
          <span class="tag">{f.tag} · <a href={f.dl} download>raw ↓</a></span>
        </div>
        <Code code={f.code} lang={f.lang as any} theme="vitesse-dark" />
      </div>
      <p style="max-width:40rem">{f.blurb}</p>
    </section>
  ))}

  <div class="section-head"><h2>The stats-publishing pipeline</h2></div>
  <p class="lede">
    The utility_meter helpers and the 00:15 GitHub push that feed the
    <a href="/stats/">stats page</a> are running on the live system now. We'll post them here once
    they've run cleanly for a few more nights. The design is written up on the
    <a href="/stack/#pipeline">stack page</a>.
  </p>
</Base>
