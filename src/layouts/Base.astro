---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';

const OCTOPUS_REFERRAL = 'https://share.octopus.energy/lush-spark-49';
const AXLE_REFERRAL = 'https://vpp.axle.energy/landing?ref=R-QADMOHUO';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: object;
}
const {
  title,
  description = 'A UK solar and battery install, documented in numbers. 10.45 kWp of Aiko panels, a Sigenergy inverter, Intelligent Octopus Go, and Home Assistant with Predbat. Real daily performance data, published automatically.',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = Astro.site?.href ?? 'https://solarbynumbers.co.uk/';
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Solar by Numbers',
      alternateName: 'solarbynumbers.co.uk',
      url: siteUrl,
      inLanguage: 'en-GB',
      description:
        'Real daily performance data from a UK solar and battery install: 22× Aiko 475W panels (10.45 kWp), a Sigenergy EC 8.0 SP hybrid inverter, 15.06 kWh SigenStor battery, Intelligent Octopus Go, and Home Assistant with Predbat.',
      publisher: { '@id': `${siteUrl}#publisher` },
      keywords: [
        'UK solar', 'home battery', 'Aiko 475W', 'Sigenergy', 'SigenStor', 'Predbat',
        'Home Assistant', 'Intelligent Octopus Go', 'Outgoing Octopus', 'Solcast', 'east west solar',
        'solar payback UK', 'battery storage', 'Axle VPP',
      ],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#publisher`,
      name: 'Solar by Numbers',
      url: siteUrl,
      logo: new URL('/og-image.png', siteUrl).href,
      description:
        'An independent, non-sponsored record of one UK household\'s 10.45 kWp solar and 15 kWh battery install, with real daily performance data published automatically from Home Assistant.',
    },
  ],
};

const nav = [
  ['/', 'home'],
  ['/stats/', 'stats'],
  ['/system/', 'system'],
  ['/stack/', 'stack'],
  ['/configs/', 'configs'],
  ['/journey/', 'journey'],
  ['/tariff/', 'tariff'],
  ['/heat-pump/', 'heat pump'],
  ['/ev/', 'car'],
  ['/faq/', 'faq'],
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Solar by Numbers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Solar by Numbers journey" href="/rss.xml" />
    <meta property="og:site_name" content="Solar by Numbers" />
    <meta property="og:title" content={`${title} · Solar by Numbers`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Solar by Numbers`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? siteJsonLd)} />
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a href="/" class="wordmark">solar <em>by numbers</em></a>
        <input type="checkbox" id="nav-toggle" aria-hidden="true" />
        <label for="nav-toggle" class="nav-burger" aria-label="Menu">≡</label>
        <nav class="site" aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap cols">
        <div>
          <span class="wordmark">solar <em>by numbers</em></span>
          <p>A personal project tracking how quickly one household's solar and battery pays back,
          measured against the original proposal. 10.45 kWp on an east/west roof in Hampshire, a
          15 kWh battery, and Home Assistant with Predbat running the lot. The numbers update
          every night, straight off the inverter.</p>
        </div>
        <div>
          <p class="kicker">Elsewhere</p>
          <ul>
            <li><a href="/journey/">Install diary</a></li>
            <li><a href="/configs/">Predbat configs</a></li>
            <li><a href="/stats/">Live stats</a></li>
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </div>
        <div>
          <p class="kicker">No sponsors</p>
          <p>The two referral links are the only money this site makes, and they pay you exactly
          what they pay us.</p>
          <p style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.8rem">
            <a class="btn octopus" href={OCTOPUS_REFERRAL} rel="noopener"><img src="/octopus-mark.png" alt="Octopus Energy" class="octopus-mark" /> £50</a>
            <a class="btn axle" href={AXLE_REFERRAL} rel="noopener"><img src="/axle-logo-black.png" alt="Axle" class="axle-mark" /> £25</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
